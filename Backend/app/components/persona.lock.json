    "../../../../../PortableComponents/Packages/Memory": {
      "id": "@ote/memory",
      "name": "Memory",
      "version": "0.1.0",
      "type": "capability",
      "sdk": "^0.6.0",
      "trust": "first-party",
      "integrity": "sha256-653df2f91ceae0c6fa8379f6755a79f6331fc91083ee7652d081260c8d4b81b2",
      "components": [
        "persona_memory",
        "recall_memory",
        "list_memories",
        "recall_memory_source",
        "remember",
        "remember_fact",
        "pin_memory",
        "forget_memory",
        "list_archived_memories",
        "restore_memory"
      ],
      "permissions": [],
      "infrastructure": {
        "required": [
          {
            "id": "postgres",
            "note": "The reference memory.v2 is Sequelize over Postgres. A different store is legal if it satisfies the MemoryStore port — this names what the reference host uses, not a law."
          }
        ],
        "graded": [
          {
            "id": "pgvector",
            "note": "embedding_hv halfvec(2048), HNSW at scale. Absent: denseRelevances returns null (NOT an empty Map — null means 'cannot answer, fall back'; empty would mean 'nothing matched' and read as amnesia). Warns once, then stops querying.",
            "degradesTo": "in-JS cosine over candidate embeddings — correct, slower, does not scale"
          },
          {
            "id": "postgres-fulltext",
            "note": "generated content_tsv column + GIN index. Absent: lexicalSearch returns []. Warns once.",
            "degradesTo": "dense-only recall — exact-word matches get weaker"
          },
          {
            "id": "embedding-model",
            "note": "host-provided embed(text); here Matryoshka-truncated qwen3-embedding via Ollama. Rows persist with embedding: null.",
            "degradesTo": "NO semantic recall — memories still store and enumerate, but relevance ranking has nothing to rank with"
          },
          {
            "id": "slot-store",
            "note": "mst_slots. Absent is silent and legal; PRESENT BUT INCOMPLETE throws — 'not provided' and 'provided broken' are different failures.",
            "degradesTo": "facts write slot_id null, exactly as before Phase 6 — reworded beliefs stop collapsing onto one concept"
          },
          {
            "id": "audit-sink",
            "note": "log_memory_changes, via an injected writer.",
            "degradesTo": "beliefs still change, the trail is missing — you lose the answer to 'where did my fact go?'"
          },
          {
            "id": "conversation-store",
            "note": "txn_messages + txn_conversations.",
            "degradesTo": "recall_memory_source returns the memory and its source id but no surrounding conversation — and that is SUCCESS, not failure"
          },
          {
            "id": "identity-interpreter-model",
            "note": "host-provided llm(prompt) for interpretIdentityLlm; here whatever memory.identityModel names, following memory.extractModel. Fires only on turns carrying a naming cue, so it is not a per-turn cost. ⚠️ Absent means SILENCE, deliberately: the English regex floor that used to cover this was deleted in RFC step 5 (2026-08-12) after measuring 1/10 against the model's 10/10. A missed name costs one turn; a wrong name is injected into every future turn and shown to the user as a fact about themselves.",
            "degradesTo": "NO self-naming capture at all — she never learns what to call someone from conversation, and falls back to the account username. Everything else in memory is unaffected"
          },
          {
            "id": "human-ask",
            "note": "the Identity Resolver's optional `ask` port; Sotera answers it with HumanInteraction's held turn. Absent is the ordinary state for non-chat callers (imports, maintenance, the model's own remember_fact) and is legal and silent. ⚠️ The degradation is DEFER, never assume — 'cannot ask' must not become 'decide for them'.",
            "degradesTo": "a name that would REPLACE a known name is deferred — logged, never written. She keeps calling them what she already called them"
          }
        ]
      }
    },
